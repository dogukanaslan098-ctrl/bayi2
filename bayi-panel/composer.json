{
  "name": "provanya/bayi-panel",
  "description": "B2B Bayi Sipariş ve Fiyatlandırma Sistemi",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-curl": "*",
    "ext-json": "*",
    "phpmailer/phpmailer": "^6.8",
    "tecnickcom/tcpdf": "^6.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Auth\\": "src/Auth/",
      "Api\\": "src/Api/",
      "Models\\": "src/Models/",
      "Services\\": "src/Services/",
      "Helpers\\": "src/Helpers/"
    }
  },
  "config": {
    "optimize-autoloader": true
  }
}
